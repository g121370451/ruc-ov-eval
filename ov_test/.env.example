# DeepRead Agent / LLM 配置 (用于检索+生成答案)
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Embedding 配置 (豆包)
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=doubao-embedding-vision-250615

# Judge 配置 (评分器，可选，不设置则 fallback 到 LLM_* 变量)
JUDGE_API_KEY=your-judge-api-key-here
JUDGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
JUDGE_MODEL=doubao-seed-1-8-251228

# Rerank 配置 (可选)
RERANK_AK=your-rerank-ak-here
RERANK_SK=your-rerank-sk-here
