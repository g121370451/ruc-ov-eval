# LLM 配置（运行时通过 ${VAR} 注入到 YAML config 中）
LLM_API_KEY=your-api-key-here
OPENAI_API_KEY=your-api-key-here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-1-8-251228
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=doubao-embedding-vision-250615

# Kimi（Moonshot）DeepRead agent 专用模型配置（config_deepread_kimi 使用）
KIMI_API_KEY=your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# DeepSeek DeepRead agent 专用模型配置（config_deepread_deepseek 使用）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
