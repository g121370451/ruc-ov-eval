# VLM/LLM 配置（与 DeepRead 共用同一套环境变量）
VLM_PROVIDER=volcengine
VLM_API_KEY=your-api-key-here
VLM_MODEL=doubao-seed-2.0-lite
VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Embedding 配置
EMBEDDING_PROVIDER=volcengine
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL=doubao-embedding-vision-250615
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
EMBEDDING_DIMENSION=2048

# 可选的 rerank 配置
RERANK_AK=your-rerank-ak-here
RERANK_SK=your-rerank-sk-here
