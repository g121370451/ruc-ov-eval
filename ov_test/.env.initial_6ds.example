# initial 六数据集基线运行配置（fb8a301 + DeepRead 7fe3ba2）
# 使用方法：复制为 ov_test/.env 并填写真实值；run_initial_6ds.sh 会 source 它。
# 注意：.env 不要提交进 git。

# ===== 答题模型 A：DeepSeek（中转站 127）=====
# 第一阶段（ds）生效；同时固定为 Judge 评审模型
DS_MODEL=
DS_BASE_URL=http://127.0.0.1:端口/v1
DS_API_KEY=

# ===== 答题模型 B：Doubao（中转站 127）=====
# 第二阶段（doubao）生效
DOUBAO_MODEL=
DOUBAO_BASE_URL=http://127.0.0.1:端口/v1
DOUBAO_API_KEY=

# ===== Judge 评审模型（两个实验共用，固定 ds）=====
# 默认跟随 DS_*；如评审要走另一个 endpoint 可单独改
JUDGE_MODEL=${DS_MODEL}
JUDGE_BASE_URL=${DS_BASE_URL}
JUDGE_API_KEY=${DS_API_KEY}

# ===== Embedding（查询向量化；旧模型）=====
# 注意：代码会在 EMBEDDING_BASE_URL 后追加 /embeddings/multimodal/embeddings，
# 所以这里填**根路径**。直连 Ark 填 https://ark.cn-beijing.volces.com/api/v3；
# 走中转站则填中转站根路径（要求中转站支持该多模态 embedding 路径）。
EMBEDDING_MODEL=doubao-embedding-vision-250615
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
